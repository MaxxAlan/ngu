# local-agents configuration
# Edit settings here. Environment variables override values in this file.
# Paths can be absolute or relative to the project folder.
#
# ngu.cmd chỉ khởi tạo/chạy chương trình; không đặt setting ở đây.

# ---- paths --------------------------------------------------------------
# LA_DATA_DIR=data
# LA_MODELS_DIR=models

# ---- server (web + mcp) -------------------------------------------------
LA_HOST=127.0.0.1
LA_PORT=8765

# ---- llama.cpp runtime --------------------------------------------------
# Thư mục chứa llama-server.exe (mặc định bundle: runtime/llama.cpp)
LA_LLAMA_DIR=runtime/llama.cpp
LA_LLAMA_HOST=127.0.0.1
LA_LLAMA_PORT_BASE=8080
# Ép device (ví dụ CUDA0, Vulkan1). Để trống = tự chọn GPU.
LA_LLAMA_DEVICE=
LA_LLAMA_CTX=32768
# ctx dung khi model khong vua VRAM (fallback tu dong)
LA_LLAMA_FALLBACK_CTX=8192
LA_LLAMA_NGL=999
# KV cache quant: q8_0 tiet VRAM (bo trong = mac dinh server)
LA_LLAMA_CACHE_TYPE=q8_0
LA_LLAMA_LOAD_TIMEOUT=180
# 1 = khi load model mới thì dừng model khác đang chạy (swap, tiết kiệm VRAM)
LA_SWAP_UNLOAD=1

# ---- model & agent ------------------------------------------------------
LA_DEFAULT_MODEL=qwen2.5-coder-3b
LA_DEFAULT_VISION_MODEL=qwen2.5-vl-3b
LA_DEFAULT_AGENT=local-agent
LA_MAX_CONCURRENCY=1
LA_REQUEST_TIMEOUT=900
LA_TEMPERATURE=0.2
# Giới hạn vòng lặp tool của agent (tăng nếu task phức tạp)
LA_AGENT_MAX_STEPS=12
LA_AGENT_SHELL_TIMEOUT=60
LA_AGENT_MAX_OUTPUT=4000
# 1 = cho phép tool đọc/ghi/list path ngoài workspace (tương đương /auto)
LA_AGENT_ALLOW_ABS=0

# ---- creative writing / tools --------------------------------------------
# Token budget cho final answer (bình thường / khi viết truyện)
LA_FINAL_MAX_TOKENS=4096
LA_CREATIVE_FINAL_MAX_TOKENS=16384
# 1 = luôn đưa tool cho model (mặc định: chỉ khi yêu cầu cần đọc/ghi file)
LA_TOOLS_ALWAYS=0

# ---- tool-call budget theo model -----------------------------------------
# call_tokens = token budget cho 1 tool call; max_calls = so tool call toi da cho 1 chuong
# (chapter dai: 20-30 call; chapter ngan: 5-10 call)
LA_MODEL_PROFILES=qwen2.5-coder-1.5b:4096:8;qwen2.5-coder-3b:8192:12;qwen2.5-7b:8192:16;gemma-4-e4b:16384:24;nemotron3-nano-4b-uncensored-hauhaucs-aggressive-q4_k_p:8192:16;default:8192:12
LA_CALL_TOKENS=8192
LA_MAX_CALLS=12

# ---- novel project (/write) ------------------------------------------------
# Độ dài mục tiêu 1 chương (từ) khi chưa có chương trước để tham chiếu
LA_NOVEL_TARGET_WORDS=1800
# Ngưỡng score để chấp nhận chương (sau khi review) - thấp hơn = dễ pass hơn
LA_NOVEL_MIN_SCORE=0.7
# Số lần viết lại tối đa khi review fail
LA_NOVEL_MAX_ATTEMPTS=2
# Số ký tự cuối chương trước đưa vào prompt (ngữ cảnh liên tục)
LA_NOVEL_TAIL_CHARS=1800
# Model riêng cho plan / review (để trống = dùng model hiện tại)
LA_NOVEL_PLAN_MODEL=
LA_NOVEL_REVIEW_MODEL=

# ---- global / workspace -------------------------------------------------
# Tên lệnh gọi global (vd: ngu). Dùng với `la.bat install` để tạo lệnh gọi từ bất kỳ đâu.
LA_COMMAND_NAME=ngu
# Chế độ xin quyền khi thao tác ngoài thư mục làm việc (1=hỏi, 0=từ chối trừ khi /auto)
LA_ASK_PERMISSION=1
